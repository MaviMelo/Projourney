FROM node:20-alpine

WORKDIR /app

RUN chown -R node:node /app

# Agora copia SEM o frontend_react/ na frente
COPY --chown=node:node package*.json ./

USER node

RUN npm install

# Copia tudo do contexto (que é frontend_react)
COPY --chown=node:node . .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host"]

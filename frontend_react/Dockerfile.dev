# --- Estágio de desenvolvimento com Hot Reload (Vite) ---
FROM node:22-alpine
WORKDIR /app

# Instala dependências
COPY package.json package-lock.json ./
RUN npm install

# Copia o restante do código fonte (bind mount sobrescreve no compose)
COPY . .

# Expõe a porta do Vite dev server
EXPOSE 5173

# Roda o Vite em modo de desenvolvimento com HMR, aceitando conexões de qualquer host
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
